#!/bin/sh

# copy the binary to /data
adb push $1 /data 2> /dev/null

# execute the binary, save its return value in
# the file pari-ret and drop \r from its output
adb shell "cd data; ./$@;"'echo $? > /data/pari-ret' | sed 's/\r//g'

# retrieve pari-ret
adb pull /data/pari-ret /tmp 2> /dev/null

# delete the pushed and generated files
adb shell rm /data/$1
adb shell rm /data/pari-ret

# return the correct value
RET=`cat /tmp/pari-ret`
rm /tmp/pari-ret
exit $RET
