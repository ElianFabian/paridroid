<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >
   <EditTextPreference
      android:key="parisize"
      android:title="parisize"
      android:inputType="number"
      android:defaultValue="@string/parisize_default"
      android:selectAllOnFocus="true"
      android:singleLine="true"
      android:maxLines="1"
   />
   <EditTextPreference
      android:key="parisizemax"
      android:title="parisizemax"
      android:inputType="number"
      android:defaultValue="@string/parisizemax_default"
      android:selectAllOnFocus="true"
      android:singleLine="true"
      android:maxLines="1"
   />
   <EditTextPreference
      android:key="primelimit"
      android:title="primelimit"
      android:inputType="number"
      android:defaultValue="@string/primelimit_default"
      android:selectAllOnFocus="true"
      android:singleLine="true"
      android:maxLines="1"
   />
</PreferenceScreen>

