<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
   xmlns:android="http://schemas.android.com/apk/res/android"
   android:id="@+id/paridroidInput"
   android:orientation="vertical"
   android:layout_width="match_parent"
   android:layout_height="match_parent" >
   <MultiAutoCompleteTextView
      android:id="@+id/inputText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingHorizontal="5dp"
      android:textColor="#000"
      android:background="#fff"
      android:scrollbars="vertical"
      android:imeOptions="flagNoExtractUi">
   </MultiAutoCompleteTextView>
   <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#000"
      android:gravity="center_vertical">
      <ImageButton
         android:id="@+id/clearButton"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_weight="1.0"
         android:src="@drawable/baseline_clear_black_24"
         android:contentDescription="@string/clear"
      />
      <ImageButton
         android:id="@+id/prevButton"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_weight="1.0"
         android:src="@drawable/baseline_arrow_back_black_24"
         android:contentDescription="@string/prev"
      />
      <ImageButton
         android:id="@+id/nextButton"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_weight="1.0"
         android:src="@drawable/baseline_arrow_forward_black_24"
         android:contentDescription="@string/next"
      />
      <ImageButton
         android:id="@+id/enterButton"
         android:layout_width="match_parent"
         android:layout_height="match_parent"
         android:layout_weight="1.0"
         android:src="@drawable/baseline_check_black_24"
         android:contentDescription="@string/enter"
      />
   </LinearLayout>
   <ListView
      android:id="@+id/resultList"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:textColor="#fff"
      android:background="#000"
   />
</LinearLayout>
